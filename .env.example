# Copy to .env. Every value is optional: with an empty file the app runs on the offline mock provider.

# mock = offline, deterministic, no key.  openai = OpenAI or any OpenAI-compatible server (Ollama, vLLM, ...).
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Set to true when the site is served over HTTPS, so the session cookie is never sent over plain HTTP.
COOKIE_SECURE=

# Ports used by ./dev.sh
API_PORT=
WEB_PORT=
